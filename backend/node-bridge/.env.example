# Firebase Admin SDK (Firebase Console → Paramètres → Comptes de service)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Propriétaire de la maison (doc Firestore users/{id})
HOUSE_USER_ID=usr_jean

# Seuil température par défaut si absent des préférences utilisateur
DEFAULT_TEMP_THRESHOLD=35
# Anti-spam alertes (ms) — même type + même appareil
ALERT_COOLDOWN_MS=30000

# Broker MQTT (HiveMQ Cloud, Mosquitto local, etc.)
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-home-bridge

# Topics — {userId} remplacé par HOUSE_USER_ID
MQTT_TOPIC_SENSOR=maison/{userId}/sensor
MQTT_TOPIC_GPIO=maison/{userId}/gpio
MQTT_TOPIC_LWT=maison/{userId}/online
